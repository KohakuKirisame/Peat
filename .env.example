PEAT_HOST=127.0.0.1
PEAT_PORT=8787
PEAT_DATA_DIR=./data
PEAT_SECURE_COOKIES=false
PEAT_REGISTRATION_OPEN=true
PEAT_CONSOLE_ENABLED=true
# Set to your external origin when using a reverse proxy.
# PEAT_ORIGINS=https://peat.example.com
# Optional Fernet key; otherwise generated in data/master.key on first launch.
# PEAT_ENCRYPTION_KEY=
# Permit a local OpenAI-compatible server by listing its hostname explicitly.
# PEAT_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
